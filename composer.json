{
    "name": "amrachraf6699/laravel-storm",
    "description": "Laravel-native load testing with PHP and k6, live traffic visualization and sampled diagnostics.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "load-testing", "performance", "k6", "diagnostics"],
    "homepage": "https://github.com/amrachraf6699/laravel-storm",
    "authors": [{"name": "Amr Achraf", "homepage": "https://github.com/amrachraf6699"}],
    "support": {
        "issues": "https://github.com/amrachraf6699/laravel-storm/issues",
        "source": "https://github.com/amrachraf6699/laravel-storm"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "guzzlehttp/guzzle": "^7.9 || ^8.3",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "symfony/css-selector": "^6.4 || ^7.2 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.2 || ^8.0",
        "symfony/process": "^6.4 || ^7.2 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {"psr-4": {"AmrAchraf\\LaravelStorm\\": "src/"}},
    "autoload-dev": {"psr-4": {"AmrAchraf\\LaravelStorm\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["AmrAchraf\\LaravelStorm\\StormServiceProvider"]}},
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": ["@test", "@lint", "@analyse"]
    },
    "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": false}},
    "archive": {"exclude": ["/tests", "/workbench", "/.github"]}
}
