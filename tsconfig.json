{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "lib": ["ES2022", "DOM"], "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["vite/client"], "noEmit": true
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "vite.config.ts"]
}
